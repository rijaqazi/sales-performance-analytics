createOrReplace
	ref table FactSalesLine
		measure 'Gross Sales' = CALCULATE(SUM(FactSalesLine[SignedLineValueGBP]), KEEPFILTERS(FactSalesLine[LineStatus] = "MerchandiseSale"))
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Sales

		measure 'Cancellation Value' = -CALCULATE(SUM(FactSalesLine[SignedLineValueGBP]), KEEPFILTERS(FactSalesLine[LineStatus] = "MerchandiseCancellation"))
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Sales

		measure 'Net Merchandise Value' = [Gross Sales] - [Cancellation Value]
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Sales

		measure 'Average Order Value' = DIVIDE([Gross Sales], [Purchase Orders])
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Orders

		measure 'Anonymous Sales' = CALCULATE([Gross Sales], KEEPFILTERS(DimCustomer[IsUnknown] = TRUE()))
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Customers

		measure 'Signed Source Value' = SUM(FactSalesLine[SignedLineValueGBP])
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Data quality

		measure 'Repeated Sale Value' = CALCULATE([Gross Sales], KEEPFILTERS(FactSalesLine[IsRepeatedLine] = TRUE()))
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Data quality

		measure 'Top 10 Product Sales' = VAR TopProducts = TOPN(10, ALLSELECTED(DimProduct), [Gross Sales], DESC, DimProduct[StockCode], ASC) RETURN IF(CONTAINS(TopProducts, DimProduct[ProductKey], SELECTEDVALUE(DimProduct[ProductKey])), [Gross Sales])
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Ranking

		measure 'Top 10 Country Sales' = VAR TopCountries = TOPN(10, ALLSELECTED(DimCountry), [Gross Sales], DESC, DimCountry[Country], ASC) RETURN IF(CONTAINS(TopCountries, DimCountry[CountryKey], SELECTEDVALUE(DimCountry[CountryKey])), [Gross Sales])
			formatString: £#,0.00;(£#,0.00);£0.00
			displayFolder: Ranking

		column UnitPrice
			dataType: decimal
			formatString: £#,0.00;(£#,0.00);£0.00
			summarizeBy: none
			sourceColumn: UnitPrice

		column SignedLineValueGBP
			dataType: decimal
			formatString: £#,0.00;(£#,0.00);£0.00
			summarizeBy: none
			sourceColumn: SignedLineValueGBP
