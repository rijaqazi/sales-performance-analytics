          },
          {
            "name": "SignedLineValueGBP",
            "dataType": "decimal",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "3ba03074-eb51-424b-96e2-39b2a8e88259",
            "sourceColumn": "SignedLineValueGBP",
            "summarizeBy": "none"
          },
          {
            "name": "IsCancellation",
            "dataType": "boolean",
            "lineageTag": "9161425b-e013-4d92-937e-e3ca9827664b",
            "sourceColumn": "IsCancellation",
            "summarizeBy": "none"
          },
          {
            "name": "CodeType",
            "dataType": "string",
            "lineageTag": "b9b94b91-71f5-4474-8d15-36d9e0d4f69c",
            "sourceColumn": "CodeType",
            "summarizeBy": "none"
          },
          {
            "name": "ClassificationBasis",
            "dataType": "string",
            "lineageTag": "26cc9ce3-2abc-406f-bc21-383ec263b6c5",
            "sourceColumn": "ClassificationBasis",
            "summarizeBy": "none"
          },
          {
            "name": "LineStatus",
            "dataType": "string",
            "lineageTag": "e808e106-e0ce-4cfb-9bc5-b532118e424e",
            "sourceColumn": "LineStatus",
            "summarizeBy": "none"
          },
          {
            "name": "IsRepeatedLine",
            "dataType": "boolean",
            "lineageTag": "5822b324-64e3-430d-b94d-a6e6fc00e41b",
            "sourceColumn": "IsRepeatedLine",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "d8fe08d3-2821-4c59-aeb9-51e217ed4d5b",
        "measures": [
          {
            "name": "Gross Sales",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(FactSalesLine[SignedLineValueGBP]), KEEPFILTERS(FactSalesLine[LineStatus] = \"MerchandiseSale\"))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "fb052f45-ec51-4857-9c14-f1323b2385a3"
          },
          {
            "name": "Cancellation Value",
            "displayFolder": "Sales",
            "expression": "-CALCULATE(SUM(FactSalesLine[SignedLineValueGBP]), KEEPFILTERS(FactSalesLine[LineStatus] = \"MerchandiseCancellation\"))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "c414f58d-e942-4fe4-a886-d2286c494a0d"
          },
          {
            "name": "Net Merchandise Value",
            "displayFolder": "Sales",
            "expression": "[Gross Sales] - [Cancellation Value]",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "f23ed4fe-6a0e-4bc4-af03-a61f856cced3"
          },
          {
            "name": "Purchase Orders",
            "displayFolder": "Orders",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSalesLine[InvoiceNumber]), KEEPFILTERS(FactSalesLine[LineStatus] = \"MerchandiseSale\"))",
            "formatString": "#,0",
            "lineageTag": "ba9b987b-1c44-4d6e-86e8-638a648b38c7"
          },
          {
            "name": "Average Order Value",
            "displayFolder": "Orders",
            "expression": "DIVIDE([Gross Sales], [Purchase Orders])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "b80844d6-deec-491e-b5f3-098625e8212d"
          },
          {
            "name": "Known Customers",
            "displayFolder": "Customers",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSalesLine[CustomerKey]), KEEPFILTERS(FactSalesLine[LineStatus] = \"MerchandiseSale\"), KEEPFILTERS(DimCustomer[IsUnknown] = FALSE()))",
            "formatString": "#,0",
            "lineageTag": "c1b52021-1350-4a44-b229-fbd19e5409df"
          },
          {
            "name": "Repeat Purchasers",
            "displayFolder": "Customers",
            "expression": "COUNTROWS(FILTER(CALCULATETABLE(VALUES(DimCustomer[CustomerKey]), KEEPFILTERS(DimCustomer[IsUnknown] = FALSE())), [Purchase Orders] >= 2))",
            "formatString": "#,0",
            "lineageTag": "3d3f1481-2900-4dc9-982e-4e211001fc8e"
          },
          {
            "name": "Repeat Purchaser Rate",
            "displayFolder": "Customers",
            "expression": "DIVIDE([Repeat Purchasers], [Known Customers])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "7a6f1d45-dd0d-423f-aa18-58b8de35e5e7"
          },
          {
            "name": "Anonymous Sales",
            "displayFolder": "Customers",
            "expression": "CALCULATE([Gross Sales], KEEPFILTERS(DimCustomer[IsUnknown] = TRUE()))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "3c11a714-3454-497e-8ea0-638942def03e"
          },
          {
            "name": "Anonymous Sales Share",
            "displayFolder": "Customers",
            "expression": "DIVIDE([Anonymous Sales], [Gross Sales])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "9b4bce1f-88b1-48bf-87ea-cf8c21e23ce5"
          },
          {
            "name": "Cancellation Value Rate",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Cancellation Value], [Gross Sales])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "adb6adae-e596-4a48-b566-ddf9b4e0e98c"
          },
          {
            "name": "Source Lines",
            "displayFolder": "Data quality",
            "expression": "COUNTROWS(FactSalesLine)",
            "formatString": "#,0",
            "lineageTag": "5d2d8b3d-260b-4e1a-92e9-d39ce00baf3d"
          },
          {
            "name": "Signed Source Value",
            "displayFolder": "Data quality",
            "expression": "SUM(FactSalesLine[SignedLineValueGBP])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "287df8ae-d2da-4150-9848-e789cc6addfc"
          },
          {
            "name": "Review Lines",
            "displayFolder": "Data quality",
            "expression": "CALCULATE(COUNTROWS(FactSalesLine), KEEPFILTERS(FactSalesLine[LineStatus] = \"ReviewCode\"))",
            "formatString": "#,0",
            "lineageTag": "09ce4da4-d74d-445e-a4e4-c80da98a0010"
          },
          {
            "name": "Repeated Sale Value",
            "displayFolder": "Data quality",
            "expression": "CALCULATE([Gross Sales], KEEPFILTERS(FactSalesLine[IsRepeatedLine] = TRUE()))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "abfd0711-c938-4573-8531-563a8b024041"
          },
          {
            "name": "Top 10 Product Sales",
            "displayFolder": "Ranking",
            "expression": "VAR TopProducts = TOPN(10, ALLSELECTED(DimProduct), [Gross Sales], DESC, DimProduct[StockCode], ASC) RETURN IF(CONTAINS(TopProducts, DimProduct[ProductKey], SELECTEDVALUE(DimProduct[ProductKey])), [Gross Sales])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "47985be9-d164-41d6-aad4-346ac9cebd0f"
          },
          {
            "name": "Top 10 Country Sales",
            "displayFolder": "Ranking",
            "expression": "VAR TopCountries = TOPN(10, ALLSELECTED(DimCountry), [Gross Sales], DESC, DimCountry[Country], ASC) RETURN IF(CONTAINS(TopCountries, DimCountry[CountryKey], SELECTEDVALUE(DimCountry[CountryKey])), [Gross Sales])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "74560d25-437b-41cb-8676-a7ebf097f75b"
          },
          {
            "name": "Comparable YoY Growth",
            "displayFolder": "Time intelligence",
            "expression": [
              "VAR CurrentDates = CALCULATETABLE(VALUES(DimDate[CalendarDate]), KEEPFILTERS(DimDate[IsCompleteSourceMonth] = TRUE()))",
              "VAR MatchedDates = FILTER(CurrentDates, VAR PriorDate = EDATE(DimDate[CalendarDate], -12) RETURN CALCULATE(COUNTROWS(DimDate), REMOVEFILTERS(DimDate), DimDate[CalendarDate] = PriorDate, DimDate[IsCompleteSourceMonth] = TRUE()) > 0)",
              "VAR PriorDates = SELECTCOLUMNS(MatchedDates, \"PriorDate\", EDATE(DimDate[CalendarDate], -12))",
              "VAR CurrentValue = CALCULATE([Gross Sales], REMOVEFILTERS(DimDate), TREATAS(MatchedDates, DimDate[CalendarDate]))",
              "VAR PriorValue = CALCULATE([Gross Sales], REMOVEFILTERS(DimDate), TREATAS(PriorDates, DimDate[CalendarDate]))",
              "RETURN DIVIDE(CurrentValue - PriorValue, PriorValue)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "a1923fdf-f77a-415d-b382-fc7dc50e7ee9"
          }
        ],
        "partitions": [
          {
            "name": "FactSalesLine",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"TELESTE\\RIJA_101\", \"SalesAnalyticsDB\"),",
                "    Data = Source{[Schema=\"dbo\",Item=\"FactSalesLine\"]}[Data]",
                "in",
                "    Data"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}