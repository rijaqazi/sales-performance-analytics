# Keep reproducible source instructions in Git; avoid large raw files.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.zip
*.bak
*.mdf
*.ldf
*.tmp
~$*
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Power BI local caches, machine settings, and lock files.
**/.pbi/
**/*.pbip.lock
